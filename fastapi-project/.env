# OpenTelemetry configuration for FastAPI service
OTEL_SERVICE_NAME=fastapi-service
OTEL_SERVICE_VERSION=1.0.0
OTEL_SERVICE_INSTANCE_ID=fastapi-service-1
OTEL_ENVIRONMENT=development

# OTLP Exporter settings
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_HTTP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_HEADERS=

# Export options
OTEL_EXPORT_CONSOLE=false
OTEL_EXPORT_OTLP=true
OTEL_USE_HTTP_EXPORTER=true

# Resource attributes
OTEL_RESOURCE_ATTRIBUTES=service.name=fastapi-service,service.version=1.0.0,deployment.environment=development

# Instrumentation settings
OTEL_PYTHON_LOG_CORRELATION=true
OTEL_PYTHON_LOG_LEVEL=info

# Trace settings
OTEL_TRACES_SAMPLER=always_on
OTEL_TRACES_EXPORTER=otlp

# Metrics settings
OTEL_METRICS_EXPORTER=otlp
OTEL_METRIC_EXPORT_INTERVAL=30000

# Logs settings
OTEL_LOGS_EXPORTER=otlp
